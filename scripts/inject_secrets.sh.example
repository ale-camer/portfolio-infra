#!/usr/bin/env bash
# ==============================================================================
# Helper Script: Inject Out-of-Band Secrets into GCP Secret Manager
# ==============================================================================
# Usage:
#   cp scripts/inject_secrets.sh.example scripts/inject_secrets.sh
#   # Edit scripts/inject_secrets.sh with your real values (NEVER commit this file)
#   bash scripts/inject_secrets.sh
# ==============================================================================
set -euo pipefail

GCP_PROJECT_ID="${GCP_PROJECT_ID:-portfolio-platform-000000}"

echo "==> Injecting 6 consolidated secrets into GCP Project: ${GCP_PROJECT_ID}..."

# 1. LLM API Key (OpenAI / Anthropic / Google)
OPENAI_KEY="${OPENAI_API_KEY:-sk-dummy-replace-with-real-key}"
printf '{"OPENAI_API_KEY":"%s","ANTHROPIC_API_KEY":"","GOOGLE_API_KEY":""}' "${OPENAI_KEY}" \
  | gcloud secrets versions add portfolio-llm-api-key \
      --project="${GCP_PROJECT_ID}" --data-file=-
echo "✓ Injected portfolio-llm-api-key"

# 2. Relational Database URL (Neon PostgreSQL 16 + pgvector)
NEON_POSTGRES_URL="${NEON_POSTGRES_URL:-postgresql://portfolio_user:password@ep-portfolio-pooler.us-east-2.aws.neon.tech/portfolio?sslmode=require}"
printf '%s' "${NEON_POSTGRES_URL}" \
  | gcloud secrets versions add portfolio-postgres-url \
      --project="${GCP_PROJECT_ID}" --data-file=-
echo "✓ Injected portfolio-postgres-url"

# 3. Financial Market API Keys (Alpha Vantage, CoinGecko, Polygon)
ALPHA_KEY="${ALPHA_VANTAGE_API_KEY:-demo}"
COINGECKO_KEY="${COINGECKO_API_KEY:-demo}"
POLYGON_KEY="${POLYGON_API_KEY:-demo}"
printf '{"ALPHA_VANTAGE_API_KEY":"%s","COINGECKO_API_KEY":"%s","POLYGON_API_KEY":"%s","GLASSNODE_API_KEY":""}' \
  "${ALPHA_KEY}" "${COINGECKO_KEY}" "${POLYGON_KEY}" \
  | gcloud secrets versions add portfolio-market-api-keys \
      --project="${GCP_PROJECT_ID}" --data-file=-
echo "✓ Injected portfolio-market-api-keys"

# 4. News & Social Media Keys (NewsAPI, Reddit)
NEWS_KEY="${NEWSAPI_API_KEY:-demo}"
REDDIT_ID="${REDDIT_CLIENT_ID:-demo}"
REDDIT_SEC="${REDDIT_CLIENT_SECRET:-demo}"
printf '{"NEWSAPI_API_KEY":"%s","REDDIT_CLIENT_ID":"%s","REDDIT_CLIENT_SECRET":"%s"}' \
  "${NEWS_KEY}" "${REDDIT_ID}" "${REDDIT_SEC}" \
  | gcloud secrets versions add portfolio-news-social-keys \
      --project="${GCP_PROJECT_ID}" --data-file=-
echo "✓ Injected portfolio-news-social-keys"

# 5. NoSQL & Cache URLs (MongoDB Atlas M0, Upstash Redis)
ATLAS_URI="${MONGODB_URI:-mongodb+srv://portfolio_app:password@cluster0.gcp.mongodb.net/portfolio?retryWrites=true&w=majority&maxPoolSize=10}"
UPSTASH_URI="${REDIS_URL:-rediss://default:token@endpoint.upstash.io:6379}"
printf '{"MONGODB_URI":"%s","REDIS_URL":"%s"}' \
  "${ATLAS_URI}" "${UPSTASH_URI}" \
  | gcloud secrets versions add portfolio-nosql-cache-urls \
      --project="${GCP_PROJECT_ID}" --data-file=-
echo "✓ Injected portfolio-nosql-cache-urls"

# 6. Application Auth & Signing Keys (JWT Secrets)
JWT_SECRET=$(openssl rand -hex 32)
API_SECRET=$(openssl rand -hex 32)
printf '{"SECRET_KEY":"%s","API_SECRET_KEY":"%s"}' \
  "${JWT_SECRET}" "${API_SECRET}" \
  | gcloud secrets versions add portfolio-app-signing-keys \
      --project="${GCP_PROJECT_ID}" --data-file=-
echo "✓ Injected portfolio-app-signing-keys"

echo "==> All 6 Secret Manager versions successfully injected."
